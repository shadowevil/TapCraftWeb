@page
@model IndexModel
@{
    ViewData["Title"] = "TapCraft";
}

<link rel="stylesheet" href="~/css/game.css" asp-append-version="true" />

<canvas id="tc-gl" aria-hidden="true"></canvas>
<canvas id="tc-canvas" aria-label="TapCraft world"></canvas>
<canvas id="tc-fx" class="tc-fx" aria-hidden="true"></canvas>

<header id="tc-topbar" class="tc-topbar">
    <button id="tc-menu-btn" class="tc-icon-btn" type="button" aria-label="Menu" title="Menu">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
    </button>
    <div class="tc-topbar-title">TapCraft</div>
</header>

<div id="tc-subbar" class="tc-subbar">
    <div class="tc-resource" title="Wood">
        <img id="tc-wood-icon" src="/assets/icons/icon_small_wood.png" alt="Wood" />
        <span id="tc-wood-count">0</span>
    </div>
    <div class="tc-resource" title="Stone">
        <img id="tc-stone-icon" src="/assets/icons/icon_stone.png" alt="Stone" />
        <span id="tc-stone-count">0</span>
    </div>
    <div class="tc-resource" title="Iron">
        <img id="tc-iron-icon" src="/assets/icons/icon_iron.png" alt="Iron" />
        <span id="tc-iron-count">0</span>
    </div>
    <div class="tc-resource" title="Gold">
        <img id="tc-gold-icon" src="/assets/icons/icon_gold.png" alt="Gold" />
        <span id="tc-gold-count">0</span>
    </div>
    <div class="tc-resource" title="Iron Ingot">
        <img id="tc-iron_ingot-icon" src="/assets/icons/icon_iron_ingot.png" alt="Iron Ingot" />
        <span id="tc-iron_ingot-count">0</span>
    </div>
    <div class="tc-resource" title="Gold Ingot">
        <img id="tc-gold_ingot-icon" src="/assets/icons/icon_gold_ingot.png" alt="Gold Ingot" />
        <span id="tc-gold_ingot-count">0</span>
    </div>
    <div class="tc-resource" title="Gold Coin">
        <img id="tc-gold_coin-icon" src="/assets/icons/icon_gold_coin.png" alt="Gold Coin" />
        <span id="tc-gold_coin-count">0</span>
    </div>
    <div class="tc-resource" title="Wheat Seeds">
        <img id="tc-wheat_seeds-icon" src="/assets/icons/icon_wheat_seeds.png" alt="Wheat Seeds" />
        <span id="tc-wheat_seeds-count">0</span>
    </div>
    <div class="tc-resource" title="Wheat">
        <img id="tc-wheat-icon" src="/assets/icons/icon_wheat.png" alt="Wheat" />
        <span id="tc-wheat-count">0</span>
    </div>
    <div id="tc-day-counter" class="tc-day-counter" title="Day">Day 1</div>
</div>

<!-- Right HUD stack (in-game): forecast + minimap panel, then playback below it -->
<div class="tc-hud-right">
    <div id="tc-forecast" class="tc-forecast" title="Conditions in your area">
        <div class="tc-minimap-wrap">
            <canvas id="tc-minimap" class="tc-minimap" width="112" height="75"></canvas>
            <div id="tc-mm-coords" class="tc-mm-coords" title="Hovered tile (col, row)">-, -</div>
            <div class="tc-mm-zoom">
                <button id="tc-mm-out" class="tc-mm-btn" type="button" aria-label="Zoom minimap out" title="Zoom out">-</button>
                <button id="tc-mm-in" class="tc-mm-btn" type="button" aria-label="Zoom minimap in" title="Zoom in">+</button>
            </div>
        </div>
        <div class="tc-fc-info">
            <div id="tc-fc-cond" class="tc-fc-cond">Clear</div>
            <div class="tc-fc-grid">
                <span class="tc-fc-k">Cloud</span><span id="tc-fc-cloud" class="tc-fc-v">-</span>
                <span class="tc-fc-k">Rain</span><span id="tc-fc-rain" class="tc-fc-v">-</span>
                <span class="tc-fc-k">Temp</span><span id="tc-fc-temp" class="tc-fc-v">-</span>
                <span class="tc-fc-k">Moisture</span><span id="tc-fc-moist" class="tc-fc-v">-</span>
                <span class="tc-fc-k">Biome</span><span id="tc-fc-biome" class="tc-fc-v">-</span>
            </div>
        </div>
    </div>
    <div class="tc-playback">
        <button id="tc-play" class="tc-icon-btn" type="button" aria-label="Play" title="Play">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5l11 7-11 7z" /></svg>
        </button>
        <button id="tc-pause" class="tc-icon-btn" type="button" aria-label="Pause" title="Pause">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h3v14H7zM14 5h3v14h-3z" /></svg>
        </button>
    </div>
</div>

<!-- Loading overlay (world generation + minimap pre-render) -->
<div id="tc-loading" class="tc-loading hidden"><div class="tc-loading-box">Loading...</div></div>

<!-- Crafted items HUD (floating icons under the left of the sub-bar) -->
<div id="tc-crafted" class="tc-crafted"></div>

<!-- Event message stack (transient toasts above the craft/build buttons) -->
<div id="tc-events" class="tc-events"></div>

<!-- Crafting opener (bottom-left corner) -->
<button id="tc-craft-btn" class="tc-craft-open" type="button">Craft</button>

<!-- Build opener (bottom-left, next to Craft) -->
<button id="tc-build-btn" class="tc-build-open" type="button">Build</button>

<!-- Build placement hint (shown while in placement mode) -->
<div id="tc-build-hint" class="tc-build-hint hidden">
    Click to place &middot; R to rotate &middot; Esc to cancel
</div>

<!-- World-anchored building info panel (positioned over the selected building) -->
<div id="tc-building-panel" class="tc-bpanel hidden">
    <div class="tc-bpanel-head">
        <img id="tc-bpanel-icon" class="tc-bpanel-icon" alt="" />
        <span class="tc-bpanel-title" id="tc-bpanel-title">Building</span>
    </div>
    <div class="tc-bpanel-row"><span class="tc-bpanel-label">Status</span><span id="tc-bpanel-status" class="tc-bpanel-val">Idle</span></div>
    <!-- Harvester rows -->
    <div class="tc-bpanel-row" data-cat="harvester">
        <span class="tc-bpanel-label">Tools</span>
        <span class="tc-bpanel-val tc-bpanel-tools-val"><img id="tc-bpanel-tool-icon" class="tc-bpanel-inline-icon" alt="" /><span id="tc-bpanel-tools">0</span></span>
    </div>
    <div class="tc-bpanel-row" data-cat="harvester"><span class="tc-bpanel-label">Workers / Speed</span><span id="tc-bpanel-bonus" class="tc-bpanel-val">1 / +0%</span></div>
    <div class="tc-bpanel-qty-row" data-cat="harvester">
        <input id="tc-bpanel-qty" class="tc-range tc-bpanel-qty" type="range" min="1" max="1" step="1" value="1" />
        <span id="tc-bpanel-qty-val" class="tc-bpanel-qty-val">1</span>
    </div>
    <div class="tc-bpanel-tools-row" data-cat="harvester">
        <button id="tc-bpanel-deposit" class="tc-btn tc-bpanel-tbtn" type="button">Deposit</button>
        <button id="tc-bpanel-withdraw" class="tc-btn tc-bpanel-tbtn" type="button">Withdraw</button>
    </div>
    <div class="tc-bpanel-row" data-cat="harvester"><span class="tc-bpanel-label">Produced</span><span id="tc-bpanel-produced" class="tc-bpanel-val">0</span></div>
    <div class="tc-bpanel-row" data-cat="harvester"><span class="tc-bpanel-label">Rate</span><span id="tc-bpanel-rate" class="tc-bpanel-val">0 / min</span></div>
    <div class="tc-bpanel-row" data-cat="harvester"><span class="tc-bpanel-label">In range</span><span id="tc-bpanel-targets" class="tc-bpanel-val">0</span></div>
    <!-- Smelter (Forge) rows: ore + fuel deposit rows are injected here -->
    <div id="tc-forge-rows" data-cat="smelter"></div>
    <!-- Crafting (Blacksmith) note -->
    <div class="tc-bpanel-row" data-cat="crafting"><span class="tc-bpanel-note">Enables iron tools and speeds stone-tool crafting.</span></div>
    <!-- Harvester Receive (collects stored output). The Forge builds its own
         per-ingot Receive buttons inside #tc-forge-rows. -->
    <button id="tc-bpanel-receive" class="tc-btn tc-primary tc-bpanel-receive" type="button" data-cat="harvester">
        <img id="tc-bpanel-receive-icon" class="tc-bpanel-inline-icon" alt="" /><span id="tc-bpanel-receive-text">Receive</span>
    </button>
    <button id="tc-bpanel-demolish" class="tc-btn tc-btn-danger tc-bpanel-demolish" type="button">Demolish</button>
</div>

<!-- Floating build panel (same movable/modular system as crafting) -->
<div id="tc-build-panel" class="tc-panel hidden">
    <div id="tc-build-titlebar" class="tc-panel-titlebar">
        <span class="tc-panel-title">Build</span>
        <button id="tc-build-close" class="tc-panel-close" type="button" aria-label="Close">X</button>
    </div>
    <div id="tc-build-list" class="tc-panel-body"></div>
</div>

<!-- In-game menu (hamburger) -->
<div id="tc-menu" class="tc-overlay hidden">
    <div class="tc-card tc-menu-card">
        <h2>Menu</h2>
        <button id="tc-resume" class="tc-btn tc-primary" type="button">Resume</button>
        <button id="tc-options" class="tc-btn" type="button">Options</button>
        <button id="tc-save" class="tc-btn" type="button">Save</button>
        <button id="tc-mainmenu" class="tc-btn" type="button">Main Menu</button>
    </div>
</div>

<!-- Options: sound channels (opened from the hamburger menu) -->
<div id="tc-options-modal" class="tc-overlay hidden">
    <div class="tc-card tc-menu-card">
        <h2>Sound</h2>
        <div id="tc-audio-rows"></div>
        <div class="tc-actions">
            <button id="tc-options-back" class="tc-btn tc-primary" type="button">Back</button>
        </div>
    </div>
</div>

<!-- Main menu / world select (over a live island background) -->
<div id="tc-mainmenu-screen" class="tc-overlay tc-mainmenu hidden">
    <div class="tc-card tc-mainmenu-card">
        <h1>TapCraft</h1>
        <p class="tc-sub">Worlds</p>
        <div id="tc-world-list" class="tc-world-list"></div>
        <button id="tc-newworld-btn" class="tc-btn tc-primary tc-wide" type="button">New World</button>
    </div>
</div>

<!-- Delete confirmation -->
<div id="tc-confirm" class="tc-overlay hidden">
    <div class="tc-card tc-menu-card">
        <h2>Delete world?</h2>
        <p id="tc-confirm-text" class="tc-confirm-text"></p>
        <div class="tc-actions">
            <button id="tc-confirm-cancel" class="tc-btn" type="button">Cancel</button>
            <button id="tc-confirm-delete" class="tc-btn tc-btn-danger" type="button">Delete</button>
        </div>
    </div>
</div>

<!-- New world / generation -->
<div id="tc-newworld" class="tc-overlay hidden">
    <div class="tc-card tc-card-wide">
        <h1>New World</h1>

        <div class="tc-row tc-newworld-top">
            <div class="tc-row-head"><label for="tc-name">Name</label></div>
            <input id="tc-name" class="tc-text" type="text" maxlength="32" placeholder="World name" />
        </div>

        <div class="tc-tabs">
            <button class="tc-tab tc-tab-active" type="button" data-tab="world">World</button>
            <button class="tc-tab" type="button" data-tab="terrain">Terrain</button>
            <button class="tc-tab" type="button" data-tab="biomes">Biomes</button>
            <button class="tc-tab" type="button" data-tab="decoration">Decoration</button>
            <button class="tc-tab" type="button" data-tab="farming">Farming</button>
            <button class="tc-tab" type="button" data-tab="ambient">Ambient &amp; Weather</button>
        </div>

        <div class="tc-tabbody">
            <div class="tc-tabpanel tc-tabpanel-active" data-panel="world">
                <div class="tc-grid">
                    <div class="tc-row tc-row-wide">
                        <div class="tc-row-head"><label for="tc-worldtype">World type</label></div>
                        <select id="tc-worldtype" class="tc-text">
                            <option value="globe">Globe - wraps around (default)</option>
                            <option value="flat">Flat island - finite</option>
                            <option value="infinite">Infinite - explore forever</option>
                        </select>
                        <p class="tc-desc">Globe wraps around in every direction so you loop back; Flat is a finite island; Infinite goes on forever.</p>
                    </div>
                    <div class="tc-row" id="tc-circ-row">
                        <div class="tc-row-head"><label for="tc-circ">Globe circumference</label><span id="tc-circ-val" class="tc-val"></span></div>
                        <input id="tc-circ" class="tc-range" type="range" min="1000" max="100000" step="100" value="2000" />
                        <p class="tc-desc">Tiles around the globe before you loop back. Bigger means more land but coarser rivers.</p>
                    </div>
                    <div class="tc-row" id="tc-size-row">
                        <div class="tc-row-head"><label for="tc-size">Map size</label><span id="tc-size-val" class="tc-val"></span></div>
                        <input id="tc-size" class="tc-range" type="range" min="16" max="10000" step="1" value="48" />
                        <p class="tc-desc">Width and height of the flat island, in tiles.</p>
                    </div>
                    <div class="tc-row">
                        <div class="tc-row-head"><label for="tc-land">Land / water</label><span id="tc-land-val" class="tc-val"></span></div>
                        <input id="tc-land" class="tc-range" type="range" min="0" max="100" step="1" value="55" />
                        <p class="tc-desc">Share of the world that is land versus ocean.</p>
                    </div>
                    <div class="tc-row">
                        <div class="tc-row-head"><label for="tc-growth">Growth rate</label><span id="tc-growth-val" class="tc-val"></span></div>
                        <input id="tc-growth" class="tc-range" type="range" min="0.1" max="10" step="0.1" value="1" />
                        <p class="tc-desc">How fast trees mature. Crops use the Farming tab's Crop growth instead.</p>
                    </div>
                    <div class="tc-row tc-row-wide">
                        <div class="tc-row-head"><label for="tc-seed">Seed</label></div>
                        <div class="tc-seed-row">
                            <input id="tc-seed" type="number" min="0" step="1" />
                            <button id="tc-seed-random" class="tc-btn" type="button">Random</button>
                        </div>
                        <p class="tc-desc">The same seed and settings always generate the same world.</p>
                    </div>
                </div>
            </div>

            <div class="tc-tabpanel" data-panel="terrain">
                <div class="tc-grid">
                    <div class="tc-row">
                        <div class="tc-row-head"><label for="tc-density">Forest density</label><span id="tc-density-val" class="tc-val"></span></div>
                        <input id="tc-density" class="tc-range" type="range" min="0" max="100" step="1" value="40" />
                        <p class="tc-desc">Overall tree coverage on suitable land.</p>
                    </div>
                    <div class="tc-row">
                        <div class="tc-row-head"><label for="tc-cluster">Forest clustering</label><span id="tc-cluster-val" class="tc-val"></span></div>
                        <input id="tc-cluster" class="tc-range" type="range" min="0" max="100" step="1" value="60" />
                        <p class="tc-desc">How tightly trees clump into woods versus scattering evenly.</p>
                    </div>
                    <div class="tc-row">
                        <div class="tc-row-head"><label for="tc-rock-density">Rock density</label><span id="tc-rock-density-val" class="tc-val"></span></div>
                        <input id="tc-rock-density" class="tc-range" type="range" min="0" max="100" step="1" value="40" />
                        <p class="tc-desc">How much rock and ore spawns across the land.</p>
                    </div>
                    <div class="tc-row">
                        <div class="tc-row-head"><label for="tc-rock-cluster">Rock clustering</label><span id="tc-rock-cluster-val" class="tc-val"></span></div>
                        <input id="tc-rock-cluster" class="tc-range" type="range" min="0" max="100" step="1" value="60" />
                        <p class="tc-desc">How tightly rocks clump into outcrops.</p>
                    </div>
                    <div class="tc-row">
                        <div class="tc-row-head"><label for="tc-mineral">Mineral cluster</label><span id="tc-mineral-val" class="tc-val"></span></div>
                        <input id="tc-mineral" class="tc-range" type="range" min="0" max="100" step="1" value="40" />
                        <p class="tc-desc">How concentrated iron and gold veins are within rock.</p>
                    </div>
                </div>
            </div>

            <div class="tc-tabpanel" data-panel="biomes">
                <div class="tc-grid">
                    <div class="tc-row tc-row-wide">
                        <div class="tc-row-head"><label for="tc-biome-size">Biome size</label><span id="tc-biome-size-val" class="tc-val"></span></div>
                        <input id="tc-biome-size" class="tc-range" type="range" min="0" max="100" step="1" value="50" />
                        <p class="tc-desc">Size of each biome region. Smaller makes a more patchwork world.</p>
                    </div>
                    <div class="tc-fieldhead">Biome mix (relative share of land)</div>
                    <div class="tc-row">
                        <div class="tc-row-head"><label for="tc-weight-meadow">Meadow</label><span id="tc-weight-meadow-val" class="tc-val"></span></div>
                        <input id="tc-weight-meadow" class="tc-range" type="range" min="0" max="10" step="1" value="3" />
                        <p class="tc-desc">Flowery open meadow.</p>
                    </div>
                    <div class="tc-row">
                        <div class="tc-row-head"><label for="tc-weight-plains">Plains</label><span id="tc-weight-plains-val" class="tc-val"></span></div>
                        <input id="tc-weight-plains" class="tc-range" type="range" min="0" max="10" step="1" value="4" />
                        <p class="tc-desc">Open grassy plains with scattered trees.</p>
                    </div>
                    <div class="tc-row">
                        <div class="tc-row-head"><label for="tc-weight-dry">Dry scrub</label><span id="tc-weight-dry-val" class="tc-val"></span></div>
                        <input id="tc-weight-dry" class="tc-range" type="range" min="0" max="10" step="1" value="2" />
                        <p class="tc-desc">Dry, sparse scrubland.</p>
                    </div>
                    <div class="tc-row">
                        <div class="tc-row-head"><label for="tc-weight-forest">Forest</label><span id="tc-weight-forest-val" class="tc-val"></span></div>
                        <input id="tc-weight-forest" class="tc-range" type="range" min="0" max="10" step="1" value="2" />
                        <p class="tc-desc">Dense woodland.</p>
                    </div>
                    <div class="tc-row">
                        <div class="tc-row-head"><label for="tc-weight-jungle">Jungle</label><span id="tc-weight-jungle-val" class="tc-val"></span></div>
                        <input id="tc-weight-jungle" class="tc-range" type="range" min="0" max="10" step="1" value="1" />
                        <p class="tc-desc">Lush, tree-packed jungle.</p>
                    </div>
                    <div class="tc-row">
                        <div class="tc-row-head"><label for="tc-weight-highland">Highland</label><span id="tc-weight-highland-val" class="tc-val"></span></div>
                        <input id="tc-weight-highland" class="tc-range" type="range" min="0" max="10" step="1" value="2" />
                        <p class="tc-desc">Rocky highland of stone and dirt.</p>
                    </div>
                </div>
            </div>

            <div class="tc-tabpanel" data-panel="decoration">
                <div class="tc-grid">
                    <div class="tc-row">
                        <div class="tc-row-head"><label for="tc-decor-density">Decoration density</label><span id="tc-decor-density-val" class="tc-val"></span></div>
                        <input id="tc-decor-density" class="tc-range" type="range" min="0" max="100" step="1" value="40" />
                        <p class="tc-desc">How many flowers and grass tufts dot the ground.</p>
                    </div>
                    <div class="tc-row">
                        <div class="tc-row-head"><label for="tc-decor-cluster">Decoration clustering</label><span id="tc-decor-cluster-val" class="tc-val"></span></div>
                        <input id="tc-decor-cluster" class="tc-range" type="range" min="0" max="100" step="1" value="60" />
                        <p class="tc-desc">How tightly decorations group into patches.</p>
                    </div>
                </div>
            </div>

            <div class="tc-tabpanel" data-panel="farming">
                <div class="tc-grid">
                    <div class="tc-row">
                        <div class="tc-row-head"><label for="tc-crop-growth">Crop growth</label><span id="tc-crop-growth-val" class="tc-val"></span></div>
                        <input id="tc-crop-growth" class="tc-range" type="range" min="0.1" max="10" step="0.1" value="1" />
                        <p class="tc-desc">Growth speed multiplier for planted crops (independent of the tree growth rate).</p>
                    </div>
                    <div class="tc-row">
                        <div class="tc-row-head"><label for="tc-wet-boost">Watering boost</label><span id="tc-wet-boost-val" class="tc-val"></span></div>
                        <input id="tc-wet-boost" class="tc-range" type="range" min="1" max="5" step="0.1" value="2.5" />
                        <p class="tc-desc">How much faster crops grow on fully watered soil versus bone dry.</p>
                    </div>
                    <div class="tc-row">
                        <div class="tc-row-head"><label for="tc-seed-chance">Seed drop chance</label><span id="tc-seed-chance-val" class="tc-val"></span></div>
                        <input id="tc-seed-chance" class="tc-range" type="range" min="0" max="25" step="1" value="5" />
                        <p class="tc-desc">Chance a foraged grass patch drops wheat seeds.</p>
                    </div>
                </div>
            </div>

            <div class="tc-tabpanel" data-panel="ambient">
                <div class="tc-grid">
                    <div class="tc-row">
                        <div class="tc-row-head"><label for="tc-bugs">Bugs</label><span id="tc-bugs-val" class="tc-val"></span></div>
                        <input id="tc-bugs" class="tc-range" type="range" min="0" max="40" step="1" value="16" />
                        <p class="tc-desc">Number of crawling land bugs.</p>
                    </div>
                    <div class="tc-row">
                        <div class="tc-row-head"><label for="tc-birds">Birds</label><span id="tc-birds-val" class="tc-val"></span></div>
                        <input id="tc-birds" class="tc-range" type="range" min="0" max="15" step="1" value="5" />
                        <p class="tc-desc">Number of birds flying overhead.</p>
                    </div>
                    <div class="tc-row">
                        <div class="tc-row-head"><label for="tc-clouds">Cloud density</label><span id="tc-clouds-val" class="tc-val"></span></div>
                        <input id="tc-clouds" class="tc-range" type="range" min="0" max="40" step="1" value="22" />
                        <p class="tc-desc">How many drifting cloud shadows pass over.</p>
                    </div>
                    <div class="tc-row">
                        <div class="tc-row-head"><label for="tc-weather-freq">Weather change</label><span id="tc-weather-freq-val" class="tc-val"></span></div>
                        <input id="tc-weather-freq" class="tc-range" type="range" min="0.5" max="10" step="0.5" value="2.5" />
                        <p class="tc-desc">Average minutes between weather changes.</p>
                    </div>
                    <div class="tc-row">
                        <div class="tc-row-head"><label for="tc-day-minutes">Day length</label><span id="tc-day-minutes-val" class="tc-val"></span></div>
                        <input id="tc-day-minutes" class="tc-range" type="range" min="4" max="40" step="1" value="10" />
                        <p class="tc-desc">Minutes of daylight per cycle.</p>
                    </div>
                    <div class="tc-row">
                        <div class="tc-row-head"><label for="tc-night-minutes">Night length</label><span id="tc-night-minutes-val" class="tc-val"></span></div>
                        <input id="tc-night-minutes" class="tc-range" type="range" min="4" max="40" step="1" value="6" />
                        <p class="tc-desc">Minutes of night per cycle.</p>
                    </div>
                    <div class="tc-row">
                        <div class="tc-row-head"><label for="tc-rain-intensity">Rain and storm intensity</label><span id="tc-rain-intensity-val" class="tc-val"></span></div>
                        <input id="tc-rain-intensity" class="tc-range" type="range" min="0.3" max="2" step="0.1" value="1" />
                        <p class="tc-desc">Strength of rain and storms.</p>
                    </div>
                    <div class="tc-fieldhead">Weather mix (relative chance)</div>
                    <div class="tc-row">
                        <div class="tc-row-head"><label for="tc-weight-clear">Clear</label><span id="tc-weight-clear-val" class="tc-val"></span></div>
                        <input id="tc-weight-clear" class="tc-range" type="range" min="0" max="10" step="1" value="6" />
                        <p class="tc-desc">Relative chance of clear skies.</p>
                    </div>
                    <div class="tc-row">
                        <div class="tc-row-head"><label for="tc-weight-cloudy">Cloudy</label><span id="tc-weight-cloudy-val" class="tc-val"></span></div>
                        <input id="tc-weight-cloudy" class="tc-range" type="range" min="0" max="10" step="1" value="3" />
                        <p class="tc-desc">Relative chance of cloudy weather.</p>
                    </div>
                    <div class="tc-row">
                        <div class="tc-row-head"><label for="tc-weight-rain">Rain</label><span id="tc-weight-rain-val" class="tc-val"></span></div>
                        <input id="tc-weight-rain" class="tc-range" type="range" min="0" max="10" step="1" value="2" />
                        <p class="tc-desc">Relative chance of rain.</p>
                    </div>
                    <div class="tc-row">
                        <div class="tc-row-head"><label for="tc-weight-storm">Storm</label><span id="tc-weight-storm-val" class="tc-val"></span></div>
                        <input id="tc-weight-storm" class="tc-range" type="range" min="0" max="10" step="1" value="1" />
                        <p class="tc-desc">Relative chance of thunderstorms.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="tc-actions">
            <button id="tc-newworld-cancel" class="tc-btn" type="button">Cancel</button>
            <button id="tc-generate" class="tc-btn tc-primary" type="button">Generate</button>
        </div>
    </div>
</div>

<!-- Floating crafting panel -->
<div id="tc-craft-panel" class="tc-panel hidden">
    <div id="tc-craft-titlebar" class="tc-panel-titlebar">
        <span class="tc-panel-title">Crafting</span>
        <button id="tc-craft-close" class="tc-panel-close" type="button" aria-label="Close">X</button>
    </div>
    <div id="tc-craft-list" class="tc-panel-body"></div>
</div>

<!-- Developer console (toggle with backtick). Blocks game interaction while open. -->
<div id="tc-console-overlay" class="tc-console-overlay hidden">
    <div id="tc-console" class="tc-console">
        <div id="tc-console-log" class="tc-console-log"></div>
        <div class="tc-console-inputrow">
            <span class="tc-console-prompt">&gt;</span>
            <input id="tc-console-input" class="tc-console-input" type="text" autocomplete="off"
                   autocorrect="off" autocapitalize="off" spellcheck="false" aria-label="Console input" />
        </div>
    </div>
</div>

<noscript>
    <div class="no-script-message">JavaScript is required to run TapCraft.</div>
</noscript>

@section Scripts {
    <script type="module" src="~/js/main.js" asp-append-version="true"></script>
}
