{
  "version": 20,

  "tiles": {
    "grass": { "src": "/assets/tiles/grass.png" },
    "dirt":  { "src": "/assets/tiles/dirt.png", "_note": "defined but not currently generated by worldgen" },
    "sand":  { "src": "/assets/tiles/sand.png" }
  },

  "water": {
    "frames": 10,
    "frameMs": 120,
    "bases": {
      "center": "water",
      "ne": "water_ne", "se": "water_se", "sw": "water_sw", "nw": "water_nw",
      "n": "water_n", "e": "water_e", "s": "water_s", "w": "water_w", "o": "water_o"
    }
  },

  "resources": {
    "wood":  { "name": "Wood",  "icon": "/assets/icons/icon_small_wood.png", "fuel": 20 },
    "stone": { "name": "Stone", "icon": "/assets/icons/icon_stone.png" },
    "iron": { "name": "Iron", "icon": "/assets/icons/icon_iron.png", "fuelCost": 2, "smeltTo": "iron_ingot" },
    "gold": { "name": "Gold", "icon": "/assets/icons/icon_gold.png", "fuelCost": 1, "smeltTo": "gold_ingot" },
    "iron_ingot": { "name": "Iron Ingot", "icon": "/assets/icons/icon_iron_ingot.png" },
    "gold_ingot": { "name": "Gold Ingot", "icon": "/assets/icons/icon_gold_ingot.png" }
  },

  "objects": {
    "tree": {
      "targetable": true,
      "drop": "wood",
      "tool": "hatchet",
      "toughness": 1,
      "chopClicks": 5,
      "placeableOn": { "tile": "grass", "requireInterior": true },
      "stageSprites": [
        "/assets/objects/seed_mound.png",
        "/assets/objects/sapling.png",
        "/assets/objects/youngling.png",
        "/assets/objects/adolescent.png"
      ],
      "matureSprites": [
        "/assets/objects/tree_1.png",
        "/assets/objects/tree_2.png"
      ]
    },
    "rock": {
      "targetable": true,
      "drop": "stone",
      "tool": "pickaxe",
      "toughness": 1,
      "placeableOn": { "tile": "grass", "requireInterior": false },
      "variantSprites": [
        "/assets/objects/rock_1.png",
        "/assets/objects/rock_2.png"
      ]
    },
    "iron_vein": {
      "targetable": true,
      "drop": "iron",
      "tool": "pickaxe",
      "toughness": 2,
      "minCount": 1,
      "placeableOn": { "tile": "grass", "requireInterior": false },
      "variantSprites": [
        "/assets/objects/iron_ore_vein_1.png"
      ]
    },
    "gold_vein": {
      "targetable": true,
      "drop": "gold",
      "tool": "pickaxe",
      "toughness": 3,
      "minCount": 1,
      "placeableOn": { "tile": "grass", "requireInterior": false },
      "variantSprites": [
        "/assets/objects/gold_ore_vein_1.png"
      ]
    }
  },

  "tools": {
    "hatchet": {
      "name": "Stone Hatchet", "kind": "hatchet", "tier": 1, "icon": "/assets/icons/cursor_hatchet.png",
      "brokenIcon": "/assets/icons/broken_hatchet_small.png",
      "output": 2, "dropChance": 0.50, "swingMs": 500, "sharpness": 1
    },
    "pickaxe": {
      "name": "Stone Pickaxe", "kind": "pickaxe", "tier": 1, "icon": "/assets/icons/cursor_pickaxe.png",
      "brokenIcon": "/assets/icons/broken_pickaxe_small.png",
      "output": 2, "dropChance": 0.50, "swingMs": 500, "sharpness": 1
    },
    "iron_hatchet": {
      "name": "Iron Hatchet", "kind": "hatchet", "tier": 2, "icon": "/assets/icons/cursor_hatchet_iron.png",
      "hudIcon": "/assets/icons/hatchet_iron_small.png",
      "brokenIcon": "/assets/icons/broken_hatchet_small.png",
      "output": 2, "dropChance": 0.50, "swingMs": 375, "sharpness": 2, "durability": 100
    },
    "iron_pickaxe": {
      "name": "Iron Pickaxe", "kind": "pickaxe", "tier": 2, "icon": "/assets/icons/cursor_pickaxe_iron.png",
      "hudIcon": "/assets/icons/pickaxe_iron_small.png",
      "brokenIcon": "/assets/icons/broken_pickaxe_small.png",
      "output": 2, "dropChance": 0.50, "swingMs": 375, "sharpness": 2, "durability": 100
    }
  },

  "harvest": {
    "toolDurability": 50,
    "baseDropChance": 0.35,
    "baseOutput": 1,
    "baseSwingMs": 1000,
    "baseSharpness": 1,
    "underSharpMult": 0.25,
    "overSharpMult": 1.5,
    "failGap": 2
  },

  "crafting": {
    "craftMs": 3000,
    "craftMax": 25,
    "blacksmithSpeedMult": 0.6,
    "recipes": {
      "stone_hatchet": { "tool": "hatchet", "cost": { "wood": 10, "stone": 5 } },
      "stone_pickaxe": { "tool": "pickaxe", "cost": { "wood": 10, "stone": 3 } },
      "iron_hatchet": { "tool": "iron_hatchet", "cost": { "iron_ingot": 5, "wood": 10 }, "requires": "blacksmith" },
      "iron_pickaxe": { "tool": "iron_pickaxe", "cost": { "iron_ingot": 5, "wood": 10 }, "requires": "blacksmith" }
    }
  },

  "buildings": {
    "logging_hut": {
      "name": "Logging Hut",
      "category": "harvester",
      "targetKind": "tree",
      "footprint": { "w": 2, "h": 2 },
      "sprites": {
        "SE": "/assets/buildings/logging_hut_se.png",
        "SW": "/assets/buildings/logging_hut_sw.png"
      },
      "placeableTiles": ["grass", "sand"],
      "buildCost": { "wood": 500, "stone": 375 },
      "harvestRadius": 5,
      "harvestSpeedMs": 4000,
      "maxTargets": 1,
      "maxTargetPerTools": 25,
      "speedBonusPerTool": 0.001,
      "maxSpeedBonus": 0.75
    },
    "mining_hut": {
      "name": "Mining Hut",
      "category": "harvester",
      "targetKind": "rock",
      "footprint": { "w": 2, "h": 2 },
      "sprites": {
        "SE": "/assets/buildings/mining_hut_se.png",
        "SW": "/assets/buildings/mining_hut_sw.png"
      },
      "placeableTiles": ["grass", "sand"],
      "buildCost": { "wood": 500, "stone": 375 },
      "harvestRadius": 5,
      "harvestSpeedMs": 4000,
      "maxTargets": 1,
      "maxTargetPerTools": 25,
      "speedBonusPerTool": 0.001,
      "maxSpeedBonus": 0.75
    },
    "forge": {
      "name": "Forge",
      "category": "smelter",
      "footprint": { "w": 2, "h": 2 },
      "sprites": {
        "SE": "/assets/buildings/forge_hut_se.png",
        "SW": "/assets/buildings/forge_hut_sw.png"
      },
      "placeableTiles": ["grass", "sand"],
      "buildCost": { "wood": 500, "stone": 250 },
      "baseSmeltMs": 60000,
      "fuelResource": "wood",
      "smelts": ["iron", "gold"],
      "smoke": {
        "frames": [
          "/assets/effects/smoke_1.png",
          "/assets/effects/smoke_2.png",
          "/assets/effects/smoke_3.png",
          "/assets/effects/smoke_4.png"
        ],
        "anchor": { "SE": [22, 4], "SW": [45, 3] },
        "opacity": 0.75,
        "scale": 1.0,
        "frameMs": 850,
        "bobPx": 0.5,
        "bobMs": 1800
      }
    },
    "blacksmith": {
      "name": "Blacksmith",
      "category": "crafting",
      "footprint": { "w": 2, "h": 2 },
      "sprites": {
        "SE": "/assets/buildings/blacksmith_se.png",
        "SW": "/assets/buildings/blacksmith_sw.png"
      },
      "placeableTiles": ["grass", "sand"],
      "buildCost": { "wood": 500, "stone": 250 }
    }
  },

  "worldgen": {
    "initialStageWeights": [0.35, 0.25, 0.18, 0.12, 0.10],
    "sandChance": [0, 0.75, 0.25],
    "stageFull": 1000,
    "gainMin": 1,
    "gainMax": 5,
    "islandMaxSize": 128,
    "growth": {
      "bands": [
        { "radius": 32, "period": 1 },
        { "radius": 72, "period": 8 },
        { "radius": 128, "period": 40 }
      ]
    },
    "rock": {
      "fillMax": 0.85,
      "scaleTight": 0.16,
      "scaleSpread": 0.05,
      "thresholdBase": 0.72,
      "thresholdDensityFactor": 0.42
    },
    "mineral": {
      "fillMax": 0.45,
      "scaleTight": 0.20,
      "scaleSpread": 0.07,
      "thresholdBase": 0.82,
      "thresholdDensityFactor": 0.30,
      "types": ["iron_vein", "gold_vein"]
    }
  },

  "defaults": {
    "worldSettings": {
      "landFraction": 0.55, "growthRate": 1.0, "forestDensity": 0.4,
      "cluster": 0.6, "rockDensity": 0.4, "rockCluster": 0.6, "mineral": 0.4
    },
    "menuForestDensity": 0.5
  },

  "sliders": {
    "size":        { "min": 16,  "max": 10000, "step": 1, "default": 48 },
    "land":        { "min": 0,   "max": 100, "step": 1,   "default": 55 },
    "growth":      { "min": 0.1, "max": 10,  "step": 0.1, "default": 1  },
    "density":     { "min": 0,   "max": 100, "step": 1,   "default": 40 },
    "cluster":     { "min": 0,   "max": 100, "step": 1,   "default": 60 },
    "rockDensity": { "min": 0,   "max": 100, "step": 1,   "default": 40 },
    "rockCluster": { "min": 0,   "max": 100, "step": 1,   "default": 60 },
    "mineral":     { "min": 0,   "max": 100, "step": 1,   "default": 40 }
  },

  "sounds": {
    "channels": { "master": 1.0, "music": 0.8, "ambience": 0.7, "effects": 1.0, "building": 0.6 },
    "buildingVolume": 0.25,
    "buildingSfxMinGapMs": 250,
    "ambience": {
      "day": ["/assets/sounds/ambience_daytime_1.ogg", "/assets/sounds/ambience_daytime_2.ogg"],
      "night": ["/assets/sounds/ambience_nighttime_1.ogg"],
      "crossfadeMs": 4000,
      "trackHoldMs": 30000
    },
    "overlays": {
      "rain": { "src": "/assets/sounds/ambience_overlay_rain_1.ogg", "loop": true, "channel": "ambience" },
      "wind": {
        "srcs": ["/assets/sounds/ambience_overlay_wind_1.ogg", "/assets/sounds/ambience_overlay_wind_2.ogg"],
        "channel": "ambience",
        "gapMinMs": 12000,
        "gapMaxMs": 30000
      }
    },
    "effects": {
      "hit_wood": [
        "/assets/sounds/effect_hit_wood_1.mp3", "/assets/sounds/effect_hit_wood_2.mp3",
        "/assets/sounds/effect_hit_wood_3.mp3", "/assets/sounds/effect_hit_wood_4.mp3",
        "/assets/sounds/effect_hit_wood_5.mp3"
      ],
      "hit_stone": [
        "/assets/sounds/effect_hit_stone_1.mp3", "/assets/sounds/effect_hit_stone_2.mp3",
        "/assets/sounds/effect_hit_stone_3.mp3", "/assets/sounds/effect_hit_stone_4.mp3",
        "/assets/sounds/effect_hit_stone_5.mp3"
      ],
      "door_open": [
        "/assets/sounds/effect_door_open_1.mp3", "/assets/sounds/effect_door_open_2.mp3",
        "/assets/sounds/effect_door_open_3.mp3"
      ]
    }
  }
}
