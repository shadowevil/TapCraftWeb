{
  "version": 3,

  "tiles": {
    "grass": { "src": "/assets/tiles/grass.png" },
    "dirt":  { "src": "/assets/tiles/dirt.png", "_note": "defined but not currently generated by worldgen" },
    "sand":  { "src": "/assets/tiles/sand.png" }
  },

  "water": {
    "frames": 10,
    "frameMs": 120,
    "bases": {
      "center": "water",
      "ne": "water_ne", "se": "water_se", "sw": "water_sw", "nw": "water_nw",
      "n": "water_n", "e": "water_e", "s": "water_s", "w": "water_w", "o": "water_o"
    }
  },

  "resources": {
    "wood":  { "name": "Wood",  "icon": "/assets/icons/icon_small_wood.png" },
    "stone": { "name": "Stone", "icon": "/assets/icons/icon_stone.png" }
  },

  "objects": {
    "tree": {
      "targetable": true,
      "drop": "wood",
      "tool": "hatchet",
      "chopClicks": 5,
      "placeableOn": { "tile": "grass", "requireInterior": true },
      "stageSprites": [
        "/assets/tiles/sprout.png",
        "/assets/objects/sapling.png",
        "/assets/objects/youngling.png",
        "/assets/objects/adolescent.png"
      ],
      "matureSprites": [
        "/assets/objects/tree_1.png",
        "/assets/objects/tree_2.png"
      ]
    },
    "rock": {
      "targetable": true,
      "drop": "stone",
      "tool": "pickaxe",
      "placeableOn": { "tile": "grass", "requireInterior": false },
      "variantSprites": [
        "/assets/objects/rock_1.png",
        "/assets/objects/rock_2.png"
      ]
    }
  },

  "tools": {
    "hatchet": { "name": "Stone Hatchet", "icon": "/assets/icons/cursor_hatchet.png" },
    "pickaxe": { "name": "Stone Pickaxe", "icon": "/assets/icons/cursor_pickaxe.png" }
  },

  "harvest": {
    "toolDurability": 50,
    "baseDropChance": 0.25,
    "toolDropChance": 0.50,
    "baseOutput": 1,
    "toolOutput": 2
  },

  "crafting": {
    "craftMs": 3000,
    "craftMax": 25,
    "recipes": {
      "stone_hatchet": { "tool": "hatchet", "cost": { "wood": 10, "stone": 5 } },
      "stone_pickaxe": { "tool": "pickaxe", "cost": { "wood": 10, "stone": 3 } }
    }
  },

  "buildings": {
    "logging_hut": {
      "name": "Logging Hut",
      "targetKind": "tree",
      "footprint": { "w": 2, "h": 2 },
      "sprites": {
        "SE": "/assets/buildings/logging_hut_se.png",
        "SW": "/assets/buildings/logging_hut_sw.png"
      },
      "placeableTiles": ["grass", "sand"],
      "buildCost": { "wood": 2000, "stone": 1500 },
      "harvestRadius": 5,
      "harvestSpeedMs": 1000,
      "maxTargets": 1,
      "sweepIntervalMs": 1500
    },
    "mining_hut": {
      "name": "Mining Hut",
      "targetKind": "rock",
      "footprint": { "w": 2, "h": 2 },
      "sprites": {
        "SE": "/assets/buildings/mining_hut_se.png",
        "SW": "/assets/buildings/mining_hut_sw.png"
      },
      "placeableTiles": ["grass", "sand"],
      "buildCost": { "wood": 2000, "stone": 1500 },
      "harvestRadius": 5,
      "harvestSpeedMs": 1000,
      "maxTargets": 1,
      "sweepIntervalMs": 1500
    }
  },

  "worldgen": {
    "initialStageWeights": [0.35, 0.25, 0.18, 0.12, 0.10],
    "sandChance": [0, 0.75, 0.25],
    "stageFull": 1000,
    "gainMin": 1,
    "gainMax": 5,
    "harvestIntervalMs": 200,
    "rock": {
      "fillMax": 0.85,
      "scaleTight": 0.16,
      "scaleSpread": 0.05,
      "thresholdBase": 0.72,
      "thresholdDensityFactor": 0.42
    }
  },

  "defaults": {
    "worldSettings": {
      "landFraction": 0.55, "growthRate": 1.0, "forestDensity": 0.4,
      "cluster": 0.6, "rockDensity": 0.4, "rockCluster": 0.6
    },
    "menuForestDensity": 0.5
  },

  "sliders": {
    "size":        { "min": 16,  "max": 64,  "step": 1,   "default": 48 },
    "land":        { "min": 0,   "max": 100, "step": 1,   "default": 55 },
    "growth":      { "min": 0.1, "max": 10,  "step": 0.1, "default": 1  },
    "density":     { "min": 0,   "max": 100, "step": 1,   "default": 40 },
    "cluster":     { "min": 0,   "max": 100, "step": 1,   "default": 60 },
    "rockDensity": { "min": 0,   "max": 100, "step": 1,   "default": 40 },
    "rockCluster": { "min": 0,   "max": 100, "step": 1,   "default": 60 }
  },

  "sounds": {
    "channels": { "master": 1.0, "music": 0.8, "ambience": 0.7, "effects": 1.0, "building": 0.6 },
    "buildingVolume": 0.25,
    "buildingSfxMinGapMs": 250,
    "ambience": {
      "day": ["/assets/sounds/ambience_daytime_1.ogg", "/assets/sounds/ambience_daytime_2.ogg"],
      "night": ["/assets/sounds/ambience_nighttime_1.ogg"],
      "crossfadeMs": 4000,
      "trackHoldMs": 30000
    },
    "overlays": {
      "rain": { "src": "/assets/sounds/ambience_overlay_rain_1.ogg", "loop": true, "channel": "ambience" },
      "wind": {
        "srcs": ["/assets/sounds/ambience_overlay_wind_1.ogg", "/assets/sounds/ambience_overlay_wind_2.ogg"],
        "channel": "ambience",
        "gapMinMs": 12000,
        "gapMaxMs": 30000
      }
    },
    "effects": {
      "hit_wood": [
        "/assets/sounds/effect_hit_wood_1.mp3", "/assets/sounds/effect_hit_wood_2.mp3",
        "/assets/sounds/effect_hit_wood_3.mp3", "/assets/sounds/effect_hit_wood_4.mp3",
        "/assets/sounds/effect_hit_wood_5.mp3"
      ],
      "hit_stone": [
        "/assets/sounds/effect_hit_stone_1.mp3", "/assets/sounds/effect_hit_stone_2.mp3",
        "/assets/sounds/effect_hit_stone_3.mp3", "/assets/sounds/effect_hit_stone_4.mp3",
        "/assets/sounds/effect_hit_stone_5.mp3"
      ],
      "door_open": [
        "/assets/sounds/effect_door_open_1.mp3", "/assets/sounds/effect_door_open_2.mp3",
        "/assets/sounds/effect_door_open_3.mp3"
      ]
    }
  }
}
